; Cisco IOS / IOS XE command collector, v0.3.0
; Run with ttpmacro.exe as a standalone macro. Tera Term 5.x is required.
; Credentials are entered in memory only. Read README before using real devices.
; No native Windows / device integration test has been performed for this release.

title = 'Cisco Command Collector 0.3.0'
connect_seconds = 15
login_seconds = 30
setup_seconds = 20
command_seconds = 120
max_hosts = 1000
max_commands = 256

; Regex constants are also checked by the offline Oniguruma scenario tests.
HOST_RE = '\A[A-Za-z0-9][A-Za-z0-9._-]{0,252}\z'
COMMAND_RE = '(?i)\Ashow +[^\x00-\x1F\x7F]+\z'
WRITE_PIPE_RE = '(?i)\|[ \t]*(?:r(?:e(?:d(?:i(?:r(?:e(?:c(?:t)?)?)?)?)?)?)?|a(?:p(?:p(?:e(?:n(?:d)?)?)?)?)?|t(?:e(?:e)?)?)(?:[ \t]|$)'
PROMPT_RE = '^[A-Za-z0-9][A-Za-z0-9_.:/()~-]{0,95}[>#][ \t]*$'
PASSWORD_RE = '(?i)(?:^|[ \t])password[ \t]*:[ \t]*$'
USERNAME_RE = '(?i)(?:^|[ \t])(?:username|login|user name)[ \t]*:[ \t]*$'
LOGIN_ERROR_RE = '(?i)(?:authentication failed|login invalid|login incorrect|access denied|bad passwords|authentication failure)'
CLI_ERROR_RE = '(?i)^(?:%[ \t]*(?:Invalid input|Incomplete command|Ambiguous command|Authorization failed|Command authorization failed|Access denied|Error|Unrecognized command|Unknown command|Permission denied|Invalid argument|Not enough|No space|.*not supported)|Error opening|TFTP:[ \t]*Error|Access violation|Permission denied|Not enough space|No space left on device|No such file or directory|Timed out(?:[ \t]|$))'
PAGER_RE = '(?:--More--|<--- More --->)'
INTERACTIVE_RE = '(?i)(?:\[confirm\]|\[yes/no\]|\[yes/no/cancel\]|Destination filename.*\?|Address or name of remote host.*\?)'

strdim hosts 1000
strdim host_folders 1000
intdim host_state 1000
strdim run_choices 2
strdim commands 256
strdim slugs 256
strdim ssh_user 2
strdim ssh_pass 2
strdim output_choices 3
strdim grouping_choices 2
strdim enable_choices 2
strdim enable_pass 2
host_count = 0
command_count = 0
summary_fd = -1
plan_fd = -1
dry_run = 0
collection_started = 0
command_started = 0
command_elapsed = -1
command_stamp = ''
command_log_opened = 0
input_fd = -1
map_fd = -1
own_terminal = 0
terminal_close_uncertain = 0
log_active = 0
abort_run = 0
run_exit = 1
command_ok_count = 0
command_issue_count = 0
tftp_unverified_count = 0
host_skip_count = 0
tacacs_failures = 0
ssh_user[0] = ''
ssh_user[1] = ''
ssh_pass[0] = ''
ssh_pass[1] = ''
telnet_user = ''
telnet_pass = ''
enable_pass[0] = ''
enable_pass[1] = ''
tacacs_user_key = ''
common_user_key = ''
auth_user = ''
auth_pass = ''
quoted_user = ''
quoted_pass = ''
quote_source = ''
quote_result = ''
quote_char = ''
connection_string = ''
inputstr = ''
matchstr = ''
groupmatchstr1 = ''
groupmatchstr2 = ''
groupmatchstr3 = ''
groupmatchstr4 = ''
groupmatchstr5 = ''
groupmatchstr6 = ''
groupmatchstr7 = ''
groupmatchstr8 = ''
groupmatchstr9 = ''
fatal_note = ''
final_note = '処理を中止しました。'
run_dir = ''
auth_trace = ''

testlink
if result <> 0 then
    messagebox 'このマクロは未接続の独立したマクロとして起動してください。start-collector.cmd または ttpmacro.exe を使用します。既存の接続には触れていません。' title
    setexitcode 2
    end
endif

getdir base_dir
sprintf2 ini_path '%s\collector.ini' base_dir
filesearch ini_path
if result = 0 then
    fatal_note = 'collector.ini が見つかりません。ZIPを展開し、同じフォルダの start-collector.cmd から起動してください。'
    goto fatal
endif

filenamebox 'ホスト一覧を選択：1行1ホスト／IPv4' 0 base_dir
if result = 0 goto cleanup
hosts_path = inputstr
filenamebox 'コマンド一覧を選択：1行1個の show コマンド' 0 base_dir
if result = 0 goto cleanup
commands_path = inputstr
inputstr = ''

input_path = hosts_path
input_kind = 0
call read_input
if parse_ok = 0 goto fatal
input_path = commands_path
input_kind = 1
call read_input
if parse_ok = 0 goto fatal
if host_count = 0 then
    fatal_note = '有効なホストがありません。'
    goto fatal
endif
if command_count = 0 then
    fatal_note = '有効な show コマンドがありません。'
    goto fatal
endif

output_choices[0] = '1. ローカル：複数コマンドをまとめて保存'
output_choices[1] = '2. ローカル：ホスト別・コマンド別に保存'
output_choices[2] = '3. 機器からTFTPへredirect：コマンド別に送信'
listbox '保存方式を選択してください。' title output_choices 1
if result < 0 goto cleanup
output_mode = result
group_all = 0
tftp_server = ''
if output_mode = 0 then
    grouping_choices[0] = 'ホストごとに1ファイル'
    grouping_choices[1] = '全ホスト・全コマンドを1ファイル'
    listbox '統合する単位を選択してください。' title grouping_choices 0
    if result < 0 goto cleanup
    group_all = result
endif
if output_mode = 2 then
    inputbox 'TFTPサーバーのIPv4またはホスト名。サーバーの公開ルート配下にホスト名フォルダを事前作成し、書込を許可してください。URLやフォルダはここには指定しません。' title
    tftp_server = inputstr
    strtrim tftp_server ' '#9
    strmatch tftp_server HOST_RE
    if result = 0 then
        fatal_note = 'TFTPサーバー名の形式が不正です。IPv4またはDNSホスト名を指定してください。'
        goto fatal
    endif
endif

inputbox '1コマンドの制限時間（秒）：5～7200。show tech-supportなどは長めに設定してください。' title '120'
strmatch inputstr '\A[0-9]{1,4}\z'
if result = 0 goto bad_timeout
str2int command_seconds inputstr
if command_seconds < 5 goto bad_timeout
if command_seconds > 7200 goto bad_timeout

run_choices[0] = '1. 収集を実行'
run_choices[1] = '2. 事前確認のみ：接続・認証せず保存計画を作成'
listbox '実行方法を選択してください。' title run_choices 0
if result < 0 goto cleanup
dry_run = result

dirnamebox '保存先フォルダを選択：配下に今回専用のフォルダを作成します。' base_dir
if result = 0 goto cleanup
output_root = inputstr
inputstr = ''

; Make a unique directory. Never reuse a previous run's output directory.
gettime run_stamp '%Y%m%d_%H%M%S'
random run_random 999999
sprintf2 run_id '%s_%06d' run_stamp run_random
sprintf2 run_dir '%s\cisco_%s' output_root run_id
strlen run_dir
if result > 170 then
    fatal_note = '保存先のパスが長すぎます。C:\CiscoLogs など短いフォルダを指定してください。'
    goto fatal
endif
foldercreate run_dir
if result <> 0 then
    fatal_note = '今回専用の保存フォルダを作成できません。書込権限、パス、同名フォルダの有無を確認してください。'
    goto fatal
endif

sprintf2 summary_path '%s\summary.tsv' run_dir
fileopen summary_fd summary_path 0
if summary_fd = -1 then
    fatal_note = 'summary.tsv を作成できません。'
    goto fatal
endif
filewriteln summary_fd 'time'#9'host'#9'auth'#9'phase'#9'command_no'#9'status'#9'artifact'#9'command'#9'started_at'#9'elapsed_seconds'#9'local_log'
host = '-'
auth_method = '-'
phase = 'RUN'
current_command_no = 0
status = 'PREPARING'
artifact = '-'
call write_summary
sprintf2 map_path '%s\commands_used.txt' run_dir
fileopen map_fd map_path 0
if map_fd = -1 then
    fatal_note = 'commands_used.txt を作成できません。'
    goto fatal
endif
for map_index 0 command_count-1
    filewriteln map_fd commands[map_index]
next
fileclose map_fd
map_fd = -1
sprintf2 map_path '%s\hosts_used.txt' run_dir
fileopen map_fd map_path 0
if map_fd = -1 then
    fatal_note = 'hosts_used.txt を作成できません。'
    goto fatal
endif
for map_index 0 host_count-1
    filewriteln map_fd hosts[map_index]
next
fileclose map_fd
map_fd = -1

; All local path/folder checks happen before credentials or connections.
call preflight
if preflight_ok = 0 goto fatal
if dry_run = 1 then
    run_exit = 4
    final_note = '事前確認が完了しました。機器への接続・認証・コマンド送信は行っていません。collection_plan.tsv を確認してください。TFTPの到達性・受信側の書込可否は未確認です。'
    goto cleanup
endif

inputbox 'TACACS用SSHでEXECへ到達しなかった回数の停止上限（全ホスト通算）：1～3。利用環境の認証ポリシーに従って指定してください。実行前や他端末の失敗数は分かりません。' title '3'
call check_tacacs_limit
if budget_ok = 0 goto bad_budget

; Credentials are DPAPI-protected outside the repository.
; start-collector.ps1 decrypts them for this process only.
getenv 'TT_TACACS_USER' ssh_user[0]
getenv 'TT_TACACS_PASS' ssh_pass[0]
getenv 'TT_COMMON_SSH_USER' ssh_user[1]
getenv 'TT_COMMON_SSH_PASS' ssh_pass[1]
getenv 'TT_COMMON_SSH_ENABLE' enable_pass[0]
getenv 'TT_COMMON_TELNET_USER' telnet_user
getenv 'TT_COMMON_TELNET_PASS' telnet_pass
getenv 'TT_COMMON_TELNET_ENABLE' enable_pass[1]

; Reject incomplete credential sets before any device connection.
strlen ssh_user[0]
tacacs_user_len = result
strlen ssh_pass[0]
tacacs_pass_len = result
if tacacs_user_len = 0 then
    if tacacs_pass_len > 0 then
        fatal_note = 'TACACS SSHのユーザー名がありません。setup-credentials.ps1 を再実行してください。'
        goto fatal
    endif
else
    if tacacs_pass_len = 0 then
        fatal_note = 'TACACS SSHのパスワードがありません。setup-credentials.ps1 を再実行してください。'
        goto fatal
    endif
endif

strlen ssh_user[1]
common_ssh_user_len = result
strlen ssh_pass[1]
common_ssh_pass_len = result
strlen enable_pass[0]
common_ssh_enable_len = result
if common_ssh_user_len = 0 then
    if common_ssh_pass_len > 0 then
        fatal_note = '共通SSHのユーザー名がありません。setup-credentials.ps1 を再実行してください。'
        goto fatal
    endif
else
    if common_ssh_pass_len = 0 then
        fatal_note = '共通SSHのパスワードがありません。setup-credentials.ps1 を再実行してください。'
        goto fatal
    endif
    if common_ssh_enable_len = 0 then
        fatal_note = '共通SSHのenableパスワードがありません。setup-credentials.ps1 を再実行してください。'
        goto fatal
    endif
endif

strlen telnet_user
telnet_user_len = result
strlen telnet_pass
telnet_pass_len = result
strlen enable_pass[1]
telnet_enable_len = result
if telnet_user_len = 0 then
    if telnet_pass_len > 0 then
        fatal_note = '共通Telnetのユーザー名がありません。setup-credentials.ps1 を再実行してください。'
        goto fatal
    endif
else
    if telnet_pass_len = 0 then
        fatal_note = '共通Telnetのパスワードがありません。setup-credentials.ps1 を再実行してください。'
        goto fatal
    endif
    if telnet_enable_len = 0 then
        fatal_note = '共通Telnetのenableパスワードがありません。setup-credentials.ps1 を再実行してください。'
        goto fatal
    endif
endif

; Validate lengths and control characters before any connection.
for credential_index 0 1
    check_value = ssh_user[credential_index]
    check_limit = 64
    call check_credential
    if credential_ok = 0 goto bad_credential
    check_value = ssh_pass[credential_index]
    check_limit = 128
    call check_credential
    if credential_ok = 0 goto bad_credential
next
check_value = telnet_user
check_limit = 64
call check_credential
if credential_ok = 0 goto bad_credential
check_value = telnet_pass
check_limit = 128
call check_credential
if credential_ok = 0 goto bad_credential
for credential_index 0 1
    check_value = enable_pass[credential_index]
    check_limit = 128
    call check_credential
    if credential_ok = 0 goto bad_credential
next
check_value = ''

strlen ssh_user[0]
method_count = result
strlen ssh_user[1]
method_count = method_count + result
strlen telnet_user
method_count = method_count + result
if method_count = 0 then
    fatal_note = '認証情報がありません。setup-credentials.ps1 を実行してから start-collector.cmd で起動してください。'
    goto fatal
endif

call check_ssh_pair
if credential_pair_ok = 0 then
    fatal_note = 'TACACS用と共通SSHに、同じユーザー名で異なるパスワードが指定されています。重複試行によるロックを避けるため接続前に停止します。setup-credentials.ps1 で共通SSHを別ユーザー名にするか無効化してください。'
    goto fatal
endif

sprintf2 notice '%d ホスト × %d コマンドを順番に取得します。保存方式=%d、制限=%d秒/コマンド。TACACS失敗停止=%d回（全体通算）。SSHエラーは手動OKが必要な場合があります。開始しますか？' host_count command_count output_mode command_seconds tacacs_failure_limit
yesnobox notice title
if result = 0 goto cleanup
collection_started = 1

for host_index 0 host_count-1
    ; Complete the previous host's other methods, but never exceed the TACACS cap.
    if tacacs_failures >= tacacs_failure_limit then
        abort_run = 1
        final_note = 'TACACS用SSHの失敗停止上限に達したため、次のホストへ進まず中止しました。直前のホストでは後続の認証方式まで試行しています。summary.tsv を確認してください。'
        break
    endif
    host = hosts[host_index]
    host_no = host_index + 1
    call make_host_name
    host_state[host_index] = 1
    host_commands_done = 0
    login_ok = 0
    auth_method = 'NONE'
    current_command_no = 0
    artifact = '-'
    phase = 'AUTH'
    sprintf2 progress '%d/%d  %s' host_no host_count host
    statusbox progress title

    auth_trace = ''
    privilege_ok = 0
    for auth_index 0 2
        login_ok = 0
        privilege_ok = 0
        privilege_status = 'NOT_CHECKED'
        tacacs_auth_failed = 0

        if auth_index < 2 then
            strlen ssh_user[auth_index]
            if result = 0 then
                continue
            endif
            if auth_index = 0 then
                auth_method = 'TACACS_SSH'
            else
                auth_method = 'COMMON_SSH'
            endif
            call try_ssh
        else
            strlen telnet_user
            if result = 0 then
                continue
            endif
            auth_method = 'COMMON_TELNET'
            call try_telnet
        endif

        status = auth_status
        phase = 'AUTH'
        current_command_no = 0
        artifact = '-'
        call write_summary

        if abort_run <> 0 then
            break
        endif

        if auth_index = 0 then
            if login_ok = 0 then
                tacacs_auth_failed = 1
            endif
        endif

        if login_ok <> 0 then
            call prepare_privilege
            phase = 'ENABLE'
            status = privilege_status
            artifact = '-'
            call write_summary
            if privilege_ok <> 0 then
                break
            endif
        endif

        sprintf2 trace_piece '%s:%s' auth_method auth_status
        if login_ok <> 0 then
            sprintf2 trace_piece '%s:%s/%s' auth_method auth_status privilege_status
        endif
        strlen auth_trace
        if result > 0 then
            strconcat auth_trace ';'
        endif
        strconcat auth_trace trace_piece

        if tacacs_auth_failed <> 0 then
            tacacs_failures = tacacs_failures + 1
        endif
        call close_terminal
    next

    if abort_run <> 0 then
        break
    endif
    if login_ok = 0 then
        host_skip_count = host_skip_count + 1
        call write_ng_file
        call close_terminal
        continue
    endif
    if privilege_ok = 0 then
        host_skip_count = host_skip_count + 1
        call write_ng_file
        call close_terminal
        continue
    endif

    phase = 'SETUP'
    wire_command = 'terminal no monitor'
    artifact = wire_command
    transaction_limit = setup_seconds
    call run_command
    status = transaction_status
    call write_summary
    if prompt_returned = 0 then
        host_skip_count = host_skip_count + 1
        call close_terminal
        continue
    endif
    wire_command = 'terminal length 0'
    artifact = wire_command
    call run_command
    status = transaction_status
    call write_summary
    if transaction_ok = 0 then
        host_skip_count = host_skip_count + 1
        call close_terminal
        continue
    endif
    wire_command = 'terminal width 0'
    artifact = wire_command
    call run_command
    status = transaction_status
    call write_summary
    if prompt_returned = 0 then
        host_skip_count = host_skip_count + 1
        call close_terminal
        continue
    endif
    for command_index 0 command_count-1
        current_command_no = command_index + 1
        phase = 'COMMAND'
        command_started = 0
        command_elapsed = -1
        command_log_opened = 0
        sprintf2 progress '%d/%d %s | コマンド %d/%d: %s' host_no host_count host_short current_command_no command_count slugs[command_index]
        statusbox progress title
        original_command = commands[command_index]
        wire_command = original_command
        ; Timestamp each command, not just the overall collection session.
        gettime command_stamp '%Y%m%d_%H%M%S'
        call make_command_paths
        call check_output_lengths
        if path_ok = 0 then
            status = path_status
            artifact = '-'
            call write_summary
            command_issue_count = command_issue_count + 1
            continue
        endif
        if output_mode = 2 then
            sprintf2 wire_command '%s | redirect %s' original_command tftp_url
        endif
        artifact = local_relative
        ; Split logs are created once; never append two commands to the same file.
        log_append = 1
        if output_mode <> 0 then
            filesearch local_path
            if result <> 0 then
                status = 'OUTPUT_ALREADY_EXISTS'
                call write_summary
                command_issue_count = command_issue_count + 1
                continue
            endif
            log_append = 0
        endif
        logopen local_path 0 log_append 1 0 1 0
        if result <> 0 then
            status = 'LOG_OPEN_FAILED'
            call write_summary
            command_issue_count = command_issue_count + 1
            abort_run = 1
            final_note = 'ログファイルを開けないため、全体を中止しました。'
            break
        endif
        log_active = 1
        command_log_opened = 1
        gettime event_time '%Y-%m-%d %H:%M:%S'
        sprintf2 log_heading '===== HOST=%s AUTH=%s COMMAND=%03d TIME=%s =====' host auth_method current_command_no event_time
        logwrite #13#10
        logwrite log_heading
        logwrite #13#10
        logwrite wire_command
        logwrite #13#10
        transaction_limit = command_seconds
        call clock_seconds
        collection_command_start = clock_value
        command_started = 1
        call run_command
        call clock_seconds
        command_elapsed = clock_value - collection_command_start
        if command_elapsed < 0 command_elapsed = command_elapsed + 86400
        status = transaction_status
        if transaction_ok <> 0 then
            host_commands_done = host_commands_done + 1
            if output_mode = 2 then
                status = 'TFTP_CLI_DONE_UNVERIFIED'
                artifact = tftp_url
                tftp_unverified_count = tftp_unverified_count + 1
            else
                command_ok_count = command_ok_count + 1
            endif
        else
            command_issue_count = command_issue_count + 1
        endif
        sprintf2 log_trailer '===== STATUS=%s =====' status
        logwrite #13#10
        logwrite log_trailer
        logwrite #13#10
        logclose
        log_active = 0
        call write_summary
        if prompt_returned = 0 then
            ; Do not send the next command into an unfinished command/interactive prompt.
            if command_index < command_count-1 then
                for skipped_index command_index+1 command_count-1
                    current_command_no = skipped_index + 1
                    command_started = 0
                    command_elapsed = -1
                    command_log_opened = 0
                    status = 'SKIPPED_SESSION_UNSAFE'
                    artifact = '-'
                    call write_summary
                next
            endif
            break
        endif
    next
    call close_terminal
    if abort_run <> 0 then
        break
    endif
    if host_commands_done = command_count then
        host_state[host_index] = 2
        if output_mode = 2 host_state[host_index] = 3
    endif
next

if abort_run = 0 then
    sprintf2 final_note '処理終了。ローカル取得OK=%d、TFTP送信操作完了・受信未検証=%d、要確認=%d、未取得ホスト=%d。summary.tsv を確認してください。' command_ok_count tftp_unverified_count command_issue_count host_skip_count
    run_exit = 0
    if tftp_unverified_count > 0 run_exit = 3
    if command_issue_count > 0 run_exit = 1
    if host_skip_count > 0 run_exit = 1
endif
goto cleanup

:bad_timeout
fatal_note = 'コマンド制限時間は5～7200秒で指定してください。'
goto fatal
:bad_budget
fatal_note = 'TACACS失敗停止上限は1～3の整数で指定してください。0（上限なし）や4以上は使用できません。'
goto fatal
:bad_credential
fatal_note = '認証情報が長すぎるか、制御文字を含みます。ユーザー名64バイト、パスワード128バイトまでです。'
goto fatal
:fatal
final_note = fatal_note
run_exit = 2
goto cleanup

; ------------------------------------------------------------
; Host input names become folder names. Keep legacy aggregate names unchanged.
:make_host_name
strcopy host 1 40 host_short
sprintf2 host_file 'h%04d_%s' host_no host_short
host_folder = host_short
strtrim host_folder '.'
strcompare host_folder host
if result <> 0 then
    sprintf2 host_folder '%s_h%04d' host_folder host_no
endif
; Windows reserves these device names even when an extension follows.
strmatch host_folder '(?i)\A(?:CON|PRN|AUX|NUL|COM[0-9]|LPT[0-9])(?:\.|$)'
if result > 0 then
    sprintf2 host_folder 'h%04d_%s' host_no host_folder
endif
return

; Inputs: host_folder, command_stamp, command_index, current_command_no.
; The command number separates duplicate commands and equal sanitized slugs.
:make_command_paths
sprintf2 local_name '%s_%s_%s_c%03d.txt' host_folder slugs[command_index] command_stamp current_command_no
sprintf2 local_relative '%s\%s' host_folder local_name
if output_mode = 0 then
    sprintf2 local_name '%s__all.txt' host_file
    if group_all = 1 then
        local_name = 'all_hosts.txt'
    endif
    local_relative = local_name
endif
if output_mode = 2 then
    sprintf2 remote_name '%s_%s_%s_c%03d_r%06d.txt' host_folder slugs[command_index] command_stamp current_command_no run_random
    sprintf2 tftp_url 'tftp://%s/%s/%s' tftp_server host_folder remote_name
    sprintf2 local_name '%s_%s_%s_c%03d_tftp.txt' host_folder slugs[command_index] command_stamp current_command_no
    sprintf2 local_relative '%s\%s' host_folder local_name
endif
sprintf2 local_path '%s\%s' run_dir local_relative
return

; Validate generated paths without opening a terminal or sending anything.
:check_output_lengths
path_ok = 1
path_status = 'READY_LOCAL_CHECK_ONLY'
strlen local_path
if result > 240 then
    path_ok = 0
    path_status = 'LOCAL_PATH_TOO_LONG'
    return
endif
if output_mode = 2 then
    strlen original_command
    wire_length = result
    strlen tftp_url
    wire_length = wire_length + result + 12
    if wire_length > 400 then
        path_ok = 0
        path_status = 'TFTP_COMMAND_TOO_LONG'
    endif
endif
return

; Detect Windows case-insensitive collisions after hostname normalization.
:check_host_folder_unique
folder_unique = 1
tolower current_folder_key host_folder
if host_index > 0 then
    for prior_host_index 0 host_index-1
        tolower prior_folder_key host_folders[prior_host_index]
        strcompare current_folder_key prior_folder_key
        if result = 0 then
            folder_unique = 0
            break
        endif
    next
endif
return

:preflight
preflight_ok = 1
preflight_errors = 0
sprintf2 plan_path '%s\collection_plan.tsv' run_dir
fileopen plan_fd plan_path 0
if plan_fd = -1 then
    preflight_ok = 0
    fatal_note = 'collection_plan.tsv を作成できません。機器には接続していません。'
    return
endif
filewriteln plan_fd 'host'#9'host_folder'#9'command_no'#9'command'#9'local_path_example'#9'tftp_url_example'#9'precheck'
command_stamp = 'YYYYMMDD_HHMMSS'
for host_index 0 host_count-1
    host = hosts[host_index]
    host_no = host_index + 1
    call make_host_name
    call check_host_folder_unique
    if folder_unique = 0 then
        preflight_ok = 0
        fatal_note = '変換後のホスト名フォルダが重複します。hosts.txtの接続先表記を確認してください。機器には接続していません。'
        break
    endif
    host_folders[host_index] = host_folder
    if output_mode <> 0 then
        sprintf2 host_dir '%s\%s' run_dir host_folder
        foldercreate host_dir
        if result <> 0 then
            preflight_ok = 0
            fatal_note = 'ホスト名フォルダを作成できません。保存先の長さ・権限を確認してください。機器には接続していません。'
            break
        endif
    endif
    for command_index 0 command_count-1
        current_command_no = command_index + 1
        original_command = commands[command_index]
        tftp_url = ''
        call make_command_paths
        call check_output_lengths
        if path_ok = 0 preflight_errors = preflight_errors + 1
        int2str number_text current_command_no
        filewrite plan_fd host
        filewrite plan_fd #9
        filewrite plan_fd host_folder
        filewrite plan_fd #9
        filewrite plan_fd number_text
        filewrite plan_fd #9
        filewrite plan_fd original_command
        filewrite plan_fd #9
        filewrite plan_fd local_path
        filewrite plan_fd #9
        filewrite plan_fd tftp_url
        filewrite plan_fd #9
        filewriteln plan_fd path_status
    next
next
fileclose plan_fd
plan_fd = -1
if preflight_ok = 0 return
if preflight_errors > 0 then
    preflight_ok = 0
    fatal_note = '保存パスまたはTFTPコマンドが長すぎます。collection_plan.tsv のprecheck列を確認し、短い保存先等へ変更してください。機器には接続していません。'
    return
endif
if output_mode = 2 then
    sprintf2 map_path '%s\tftp_folders.txt' run_dir
    fileopen map_fd map_path 0
    if map_fd = -1 then
        preflight_ok = 0
        fatal_note = 'TFTPフォルダ一覧を作成できません。機器には接続していません。'
        return
    endif
    for map_index 0 host_count-1
        filewriteln map_fd host_folders[map_index]
    next
    fileclose map_fd
    map_fd = -1
endif
current_command_no = 0
return

; Host list selection is deliberately manual; no retry or authentication occurs.
:write_review_lists
for review_kind 0 1
    if review_kind = 0 then
        sprintf2 map_path '%s\hosts_need_review.txt' run_dir
    else
        sprintf2 map_path '%s\hosts_tftp_unverified.txt' run_dir
    endif
    fileopen map_fd map_path 0
    if map_fd = -1 then
        run_exit = 1
        strconcat final_note #13#10'要確認ホスト一覧を作成できません。summary.tsv と hosts_used.txt を確認してください。'
        return
    endif
    for review_index 0 host_count-1
        review_include = 0
        if review_kind = 0 then
            if host_state[review_index] < 2 review_include = 1
        else
            if host_state[review_index] = 3 review_include = 1
        endif
        if review_include = 1 then
            filewriteln map_fd hosts[review_index]
        endif
    next
    fileclose map_fd
    map_fd = -1
next
return

; ------------------------------------------------------------
; Read-only input parser. Nonempty last line is processed even at EOF.
:read_input
parse_ok = 1
fileopen input_fd input_path 0 1
if input_fd = -1 then
    parse_ok = 0
    fatal_note = '入力ファイルを開けません。'
    return
endif
line_number = 0
while 1
    raw_line = ''
    filereadln input_fd raw_line
    at_eof = result
    line_number = line_number + 1
    strlen raw_line
    if result >= 511 then
        parse_ok = 0
        break
    endif
    if line_number = 1 then
        strcopy raw_line 1 3 bom_probe
        strcompare bom_probe #239#187#191
        if result = 0 then
            strremove raw_line 1 3
        endif
    endif
    strtrim raw_line ' '#9
    strlen raw_line
    if result > 0 then
        strmatch raw_line '\A[#;]'
        if result = 0 then
            if input_kind = 0 then
                strmatch raw_line HOST_RE
                if result = 0 then
                    parse_ok = 0
                    break
                endif
                if host_count >= max_hosts then
                    parse_ok = 0
                    break
                endif
                ; Case-insensitive duplicate hostnames are rejected before authentication.
                tolower normalized_host raw_line
                if host_count > 0 then
                    for duplicate_index 0 host_count-1
                        tolower old_host hosts[duplicate_index]
                        strcompare normalized_host old_host
                        if result = 0 then
                            parse_ok = 0
                            break
                        endif
                    next
                endif
                if parse_ok = 0 then
                    break
                endif
                hosts[host_count] = raw_line
                host_count = host_count + 1
            else
                strlen raw_line
                if result > 240 then
                    parse_ok = 0
                    break
                endif
                strmatch raw_line COMMAND_RE
                if result = 0 then
                    parse_ok = 0
                    break
                endif
                strmatch raw_line WRITE_PIPE_RE
                if result > 0 then
                    parse_ok = 0
                    break
                endif
                strscan raw_line '?'
                if result > 0 then
                    parse_ok = 0
                    break
                endif
                if command_count >= max_commands then
                    parse_ok = 0
                    break
                endif
                commands[command_count] = raw_line
                strcopy raw_line 1 24 slug
                while 1
                    strreplace slug 1 '[^A-Za-z0-9._-]' '_'
                    if result = 0 then
                        break
                    endif
                endwhile
                slugs[command_count] = slug
                command_count = command_count + 1
            endif
        endif
    endif
    if at_eof <> 0 then
        break
    endif
endwhile
fileclose input_fd
input_fd = -1
if parse_ok = 0 then
    if input_kind = 0 then
        sprintf2 fatal_note 'ホスト一覧の%d行目が不正、重複、長すぎる、または1000件を超えています。IPv4/DNS名を1行1件で指定してください。' line_number
    else
        sprintf2 fatal_note 'コマンド一覧の%d行目が不正です。240バイト以内のshowコマンド、最大256件。?、制御文字、redirect/append/tee（省略形含む）は入力できません。' line_number
    endif
endif
return

:check_credential
credential_ok = 1
strlen check_value
if result > check_limit then
    credential_ok = 0
endif
strmatch check_value '[\x00-\x1F\x7F]'
if result > 0 then
    credential_ok = 0
endif
check_value = ''
matchstr = ''
return

; The command-line quoting documented by TTSSH doubles embedded double quotes.
:quote_argument
quote_result = ''
strlen quote_source
quote_length = result
if quote_length = 0 then
    return
endif
for quote_index 1 quote_length
    strcopy quote_source quote_index 1 quote_char
    strcompare quote_char '"'
    if result = 0 then
        strconcat quote_result '"'
    endif
    strconcat quote_result quote_char
next
quote_source = ''
quote_char = ''
return

; Never put credentials in the FIRST connect: that would expose process arguments.
:launch_terminal
launch_ok = 0
call close_terminal
if terminal_close_uncertain <> 0 then
    return
endif
testlink
if result <> 0 then
    abort_run = 1
    final_note = '前のTera Termとのリンクが残っているため中止しました。'
    return
endif
sprintf2 bootstrap '/DS /NOLOG /AUTOWINCLOSE=off /F="%s"' ini_path
connect bootstrap
testlink
if result = 1 then
    own_terminal = 1
    launch_ok = 1
    logclose
    setsync 0
    sprintf2 terminal_title 'Cisco Collector %s' run_id
    settitle terminal_title
else
    ; The dedicated INI must never establish a connection by itself.
    if result <> 0 then
        own_terminal = 1
    endif
    abort_run = 1
    final_note = '未接続の専用Tera Termを起動できないため中止しました。collector.iniとTera Termの配置を確認してください。'
endif
return

:try_ssh
auth_status = 'SSH_NO_EXEC_PROMPT'
call launch_terminal
if launch_ok = 0 then
    auth_status = 'TERMINAL_START_FAILED'
    return
endif
auth_user = ssh_user[auth_index]
auth_pass = ssh_pass[auth_index]
quote_source = auth_user
call quote_argument
quoted_user = quote_result
quote_source = auth_pass
call quote_argument
quoted_pass = quote_result
quote_result = ''
strlen host
connection_length = result
strlen quoted_user
connection_length = connection_length + result
strlen quoted_pass
connection_length = connection_length + result + 100
if connection_length > 500 then
    auth_status = 'SSH_ARGUMENT_TOO_LONG'
    call clear_attempt_secret
    return
endif
; Abort if the DDE link disappeared: NEVER spawn a process with /passwd.
testlink
if result <> 1 then
    auth_status = 'DDE_LINK_LOST'
    abort_run = 1
    final_note = '認証直前にDDEリンクを失ったため中止しました。'
    call clear_attempt_secret
    return
endif
sprintf2 connection_string '%s:22 /ssh /2 /auth=password /user="%s" /passwd="%s" /TIMEOUT=%d /AUTOWINCLOSE=off /NOLOG' host quoted_user quoted_pass connect_seconds
connect connection_string
call clear_attempt_secret
testlink
if result <> 2 then
    auth_status = 'SSH_NOT_CONNECTED'
    return
endif
timeout = login_seconds
mtimeout = 0
waitregex PROMPT_RE LOGIN_ERROR_RE USERNAME_RE PASSWORD_RE
login_result = result
if login_result = 1 then
    learned_prompt = matchstr
    strtrim learned_prompt ' '#9#13#10
    login_ok = 1
    auth_status = 'EXEC_PROMPT_REACHED'
elseif login_result = 2 then
    auth_status = 'SSH_LOGIN_ERROR_TEXT'
elseif login_result > 2 then
    auth_status = 'SSH_EXTRA_AUTH_PROMPT'
else
    auth_status = 'SSH_EXEC_TIMEOUT'
endif
return

:clear_attempt_secret
connection_string = ''
auth_user = ''
auth_pass = ''
quoted_user = ''
quoted_pass = ''
quote_source = ''
quote_result = ''
quote_char = ''
inputstr = ''
matchstr = ''
return

:try_telnet
auth_status = 'TELNET_NOT_CONNECTED'
call launch_terminal
if launch_ok = 0 then
    auth_status = 'TERMINAL_START_FAILED'
    return
endif
sprintf2 connection_string '%s:23 /nossh /T=1 /TIMEOUT=%d /AUTOWINCLOSE=off /NOLOG' host connect_seconds
connect connection_string
connection_string = ''
testlink
if result <> 2 then
    return
endif

timeout = login_seconds
mtimeout = 0
waitregex PROMPT_RE USERNAME_RE PASSWORD_RE LOGIN_ERROR_RE
telnet_result = result
if telnet_result = 1 then
    learned_prompt = matchstr
    strtrim learned_prompt ' '#9#13#10
    login_ok = 1
    auth_status = 'EXEC_PROMPT_REACHED'
    return
elseif telnet_result = 2 then
    sendln telnet_user
    waitregex PROMPT_RE PASSWORD_RE LOGIN_ERROR_RE USERNAME_RE
    telnet_result = result
    if telnet_result = 1 then
        learned_prompt = matchstr
        strtrim learned_prompt ' '#9#13#10
        login_ok = 1
        auth_status = 'EXEC_PROMPT_REACHED'
        return
    elseif telnet_result <> 2 then
        auth_status = 'TELNET_USERNAME_REJECTED'
        return
    endif
elseif telnet_result = 3 then
    ; Password-first VTY remains supported for compatibility.
else
    if telnet_result = 0 then
        auth_status = 'TELNET_LOGIN_TIMEOUT'
    else
        auth_status = 'TELNET_AUTH_REJECTED'
    endif
    return
endif

sendln telnet_pass
waitregex PROMPT_RE LOGIN_ERROR_RE PASSWORD_RE USERNAME_RE
telnet_result = result
if telnet_result = 1 then
    learned_prompt = matchstr
    strtrim learned_prompt ' '#9#13#10
    login_ok = 1
    auth_status = 'EXEC_PROMPT_REACHED'
elseif telnet_result = 0 then
    auth_status = 'TELNET_EXEC_TIMEOUT'
else
    auth_status = 'TELNET_AUTH_REJECTED'
endif
return

; A client-side failure cap cannot determine the remaining server-side budget.
:check_tacacs_limit
budget_ok = 0
strmatch inputstr '\A[1-3]\z'
if result = 0 then
    return
endif
str2int tacacs_failure_limit inputstr
budget_ok = 1
return

; Case-insensitive comparison is conservative; AAA aliases are not discoverable.
:check_ssh_pair
credential_pair_ok = 1
tolower tacacs_user_key ssh_user[0]
tolower common_user_key ssh_user[1]
strlen tacacs_user_key
if result > 0 then
    strcompare tacacs_user_key common_user_key
    if result = 0 then
        strcompare ssh_pass[0] ssh_pass[1]
        if result <> 0 then
            credential_pair_ok = 0
        else
            ssh_user[1] = ''
            ssh_pass[1] = ''
            enable_pass[0] = ''
        endif
    endif
endif
tacacs_user_key = ''
common_user_key = ''
return

:prepare_privilege
privilege_ok = 0
privilege_status = 'UNEXPECTED_PROMPT'
strtrim learned_prompt ' '#9#13#10
strmatch learned_prompt PROMPT_RE
if result = 0 then
    return
endif
strscan learned_prompt '('
if result > 0 then
    return
endif
if auth_index < 0 then
    privilege_status = 'UNEXPECTED_AUTH_METHOD'
    return
endif
if auth_index > 2 then
    privilege_status = 'UNEXPECTED_AUTH_METHOD'
    return
endif
strmatch learned_prompt '>$'
if result > 0 then
    if auth_index = 0 then
        ; Authentication succeeded, but the promised TACACS privilege is absent.
        ; Do not send enable, retry a password, or fall back to another account.
        privilege_status = 'TACACS_NOT_PRIVILEGED'
        return
    endif
    enable_index = auth_index - 1
    strlen learned_prompt
    enable_prompt_length = result - 1
    strcopy learned_prompt 1 enable_prompt_length expected_enable_prompt
    strconcat expected_enable_prompt '#'
    flushrecv
    sendln 'enable'
    timeout = login_seconds
    waitregex PROMPT_RE PASSWORD_RE LOGIN_ERROR_RE CLI_ERROR_RE
    enable_result = result
    if enable_result = 2 then
        strlen enable_pass[enable_index]
        if result = 0 then
            privilege_status = 'ENABLE_PASSWORD_REQUIRED'
            return
        endif
        sendln enable_pass[enable_index]
        waitregex PROMPT_RE LOGIN_ERROR_RE PASSWORD_RE CLI_ERROR_RE
        enable_result = result
    endif
    if enable_result <> 1 then
        privilege_status = 'ENABLE_FAILED'
        return
    endif
    learned_prompt = matchstr
    strtrim learned_prompt ' '#9#13#10
    strscan learned_prompt '('
    if result > 0 then
        privilege_status = 'UNEXPECTED_ENABLE_PROMPT'
        return
    endif
    strmatch learned_prompt '#$'
    if result = 0 then
        privilege_status = 'ENABLE_NOT_PRIVILEGED'
        return
    endif
    strcompare learned_prompt expected_enable_prompt
    if result <> 0 then
        privilege_status = 'UNEXPECTED_ENABLE_PROMPT'
        return
    endif
endif
; Escape the actual prompt, rather than waiting for any occurrence of # or >.
prompt_pattern = '^'
strlen learned_prompt
prompt_length = result
for prompt_index 1 prompt_length
    strcopy learned_prompt prompt_index 1 prompt_char
    strscan '\.^$|?*+()[]{}' prompt_char
    if result > 0 then
        strconcat prompt_pattern '\'
    endif
    strconcat prompt_pattern prompt_char
next
strconcat prompt_pattern '[ \t]*$'
privilege_ok = 1
privilege_status = 'READY'
return

; Execute one command. The log, if open, records full receive data independently.
; Completion is an exact learned prompt after a verified command echo.
; No further command is sent on ambiguity. Cisco's normal command echo is required.
:run_command
transaction_ok = 0
prompt_returned = 0
transaction_status = 'DISCONNECTED'
error_seen = 0
testlink
if result <> 2 then
    return
endif
flushrecv
setsync 1
call clock_seconds
transaction_start = clock_value
sendln wire_command
mtimeout = 0
; Skip unsolicited complete lines until the actual echo is confirmed.
; This prevents an echo beginning with HOST# from being mistaken for completion.
while 1
    call remaining_time
    if remaining_seconds <= 0 then
        transaction_status = 'ECHO_NOT_CONFIRMED_TIMEOUT'
        setsync 0
        return
    endif
    timeout = remaining_seconds
    recvln
    if result = 0 then
        testlink
        if result = 2 then
            transaction_status = 'ECHO_NOT_CONFIRMED_TIMEOUT'
        else
            transaction_status = 'DISCONNECTED_INCOMPLETE'
        endif
        setsync 0
        return
    endif
    echo_line = inputstr
    strtrim echo_line ' '#9#13#10
    strcompare echo_line wire_command
    if result = 0 then
        break
    endif
    strcopy echo_line 1 prompt_length echo_prefix
    strcompare echo_prefix learned_prompt
    if result = 0 then
        strremove echo_line 1 prompt_length
        strtrim echo_line ' '#9
        strcompare echo_line wire_command
        if result = 0 then
            break
        endif
    endif
    strmatch echo_line CLI_ERROR_RE
    if result > 0 then
        error_seen = 1
    endif
    strmatch echo_line PAGER_RE
    if result > 0 then
        transaction_status = 'PAGING_DETECTED_INCOMPLETE'
        setsync 0
        return
    endif
    strmatch echo_line INTERACTIVE_RE
    if result > 0 then
        transaction_status = 'INTERACTIVE_PROMPT_ABORTED'
        setsync 0
        return
    endif
endwhile
while 1
    call remaining_time
    if remaining_seconds <= 0 then
        transaction_status = 'COMMAND_TIMEOUT'
        break
    endif
    timeout = remaining_seconds
    waitregex prompt_pattern CLI_ERROR_RE PAGER_RE INTERACTIVE_RE PROMPT_RE
    transaction_result = result
    if transaction_result = 1 then
        prompt_returned = 1
        if error_seen = 0 then
            transaction_ok = 1
            transaction_status = 'LOCAL_CLI_DONE'
        else
            transaction_status = 'CLI_ERROR_TEXT_REVIEW'
        endif
        break
    elseif transaction_result = 2 then
        error_seen = 1
    elseif transaction_result = 3 then
        transaction_status = 'PAGING_DETECTED_INCOMPLETE'
        break
    elseif transaction_result = 4 then
        transaction_status = 'INTERACTIVE_PROMPT_ABORTED'
        break
    elseif transaction_result = 5 then
        transaction_status = 'PROMPT_CHANGED_ABORTED'
        break
    else
        testlink
        if result = 2 then
            transaction_status = 'COMMAND_TIMEOUT'
        else
            transaction_status = 'DISCONNECTED_INCOMPLETE'
        endif
        break
    endif
endwhile
setsync 0
return

:remaining_time
call clock_seconds
elapsed_seconds = clock_value - transaction_start
if elapsed_seconds < 0 then
    elapsed_seconds = elapsed_seconds + 86400
endif
remaining_seconds = transaction_limit - elapsed_seconds
return

; Wall clock, wrapped across midnight. Maximum configured command timeout is 2h.
:clock_seconds
gettime clock_text '%H%M%S'
strcopy clock_text 1 2 clock_part
str2int clock_h clock_part
strcopy clock_text 3 2 clock_part
str2int clock_m clock_part
strcopy clock_text 5 2 clock_part
str2int clock_s clock_part
clock_value = clock_h*3600 + clock_m*60 + clock_s
return

:write_summary
if summary_fd = -1 then
    return
endif
gettime event_time '%Y-%m-%d %H:%M:%S'
int2str number_text current_command_no
filewrite summary_fd event_time
filewrite summary_fd #9
filewrite summary_fd host
filewrite summary_fd #9
filewrite summary_fd auth_method
filewrite summary_fd #9
filewrite summary_fd phase
filewrite summary_fd #9
filewrite summary_fd number_text
filewrite summary_fd #9
filewrite summary_fd status
filewrite summary_fd #9
filewrite summary_fd artifact
summary_command = ''
summary_started = ''
summary_elapsed = ''
summary_local = ''
strcompare phase 'COMMAND'
if result = 0 then
    if current_command_no > 0 then
        summary_command = commands[current_command_no-1]
        if command_started = 1 then
            summary_started = command_stamp
            int2str summary_elapsed command_elapsed
        endif
        if command_log_opened = 1 summary_local = local_relative
    endif
endif
filewrite summary_fd #9
filewrite summary_fd summary_command
filewrite summary_fd #9
filewrite summary_fd summary_started
filewrite summary_fd #9
filewrite summary_fd summary_elapsed
filewrite summary_fd #9
filewriteln summary_fd summary_local
return

:write_ng_file
sprintf2 ng_relative '%s_NG.txt' host_folder
sprintf2 ng_path '%s\%s' run_dir ng_relative
fileopen ng_fd ng_path 0
if ng_fd <> -1 then
    gettime ng_time '%Y-%m-%d %H:%M:%S'
    filewriteln ng_fd 'result=NG'
    sprintf2 ng_line 'host=%s' host
    filewriteln ng_fd ng_line
    sprintf2 ng_line 'time=%s' ng_time
    filewriteln ng_fd ng_line
    filewriteln ng_fd 'reason=authentication_or_privilege_failed'
    sprintf2 ng_line 'attempts=%s' auth_trace
    filewriteln ng_fd ng_line
    fileclose ng_fd
endif
phase = 'AUTH'
status = 'AUTH_ALL_FAILED'
artifact = ng_relative
current_command_no = 0
call write_summary
return

:close_terminal
if terminal_close_uncertain <> 0 then
    return
endif
if own_terminal <> 0 then
    testlink
    if result <> 0 then
        setsync 0
        if log_active <> 0 then
            logclose
            log_active = 0
        endif
        testlink
        if result = 2 then
            disconnect 0
            ; Confirm transport disconnect BEFORE closett. closett itself unlinks DDE.
            for close_poll 1 50
                mpause 100
                testlink
                if result <> 2 then
                    break
                endif
            next
            testlink
            if result = 2 then
                terminal_close_uncertain = 1
                abort_run = 1
                final_note = '切断完了を確認できないため全体を中止しました。TTSSHのエラーダイアログと、このマクロ用のCisco Collectorウィンドウを手動で閉じてください。'
                return
            endif
        endif
        testlink
        if result <> 0 then
            ; Request window closure; DDE unlink alone does not prove process exit.
            closett
        endif
    endif
    own_terminal = 0
endif
return

:cleanup
; Credentials are stored by the launcher with DPAPI. Empty variables are NOT secure memory erase.
ssh_user[0] = ''
ssh_user[1] = ''
ssh_pass[0] = ''
ssh_pass[1] = ''
telnet_user = ''
telnet_pass = ''
enable_pass[0] = ''
enable_pass[1] = ''
tacacs_user_key = ''
common_user_key = ''
check_value = ''
auth_trace = ''
trace_piece = ''
call clear_attempt_secret
groupmatchstr1 = ''
groupmatchstr2 = ''
groupmatchstr3 = ''
groupmatchstr4 = ''
groupmatchstr5 = ''
groupmatchstr6 = ''
groupmatchstr7 = ''
groupmatchstr8 = ''
groupmatchstr9 = ''
call close_terminal
if input_fd <> -1 then
    fileclose input_fd
endif
if map_fd <> -1 then
    fileclose map_fd
endif
if plan_fd <> -1 then
    fileclose plan_fd
    plan_fd = -1
endif
if collection_started = 1 call write_review_lists
if summary_fd <> -1 then
    host = '-'
    auth_method = '-'
    phase = 'RUN'
    current_command_no = 0
    artifact = '-'
    status = 'STOPPED_OR_INCOMPLETE'
    if run_exit = 0 status = 'FINISHED_LOCAL'
    if run_exit = 2 status = 'INPUT_OR_SETUP_ERROR'
    if run_exit = 3 status = 'FINISHED_TFTP_UNVERIFIED'
    if run_exit = 4 status = 'PRECHECK_ONLY_NO_CONNECTION'
    call write_summary
    fileclose summary_fd
endif
closesbox
strlen run_dir
if result > 0 then
    strconcat final_note #13#10#13#10
    strconcat final_note run_dir
endif
messagebox final_note title
setexitcode run_exit
end
